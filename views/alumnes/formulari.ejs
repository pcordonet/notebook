<%- include('../header') %>

<div class="row">
    <div class="col-md-8 offset-md-2">
        <h1 class="mb-4">
            <i class="bi bi-people"></i>
            <%= alumne && alumne.id ? 'Modificar Alumne' : 'Crear Alumne' %>
        </h1>

        <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle"></i> <%= error %>
        </div>
        <% } %>

        <div class="card">
            <div class="card-body">
                <form action="<%= alumne && alumne.id ? '/alumnes/' + alumne.id + '/editar' : '/alumnes/crear' %>" method="POST">
                    <div class="mb-3">
                        <label for="nom" class="form-label">Nom *</label>
                        <input type="text" class="form-control" id="nom" name="nom"
                               value="<%= alumne ? alumne.nom : '' %>" required>
                    </div>

                    <div class="mb-3">
                        <label for="cognoms" class="form-label">Cognoms *</label>
                        <input type="text" class="form-control" id="cognoms" name="cognoms"
                               value="<%= alumne ? alumne.cognoms : '' %>" required>
                    </div>

                    <div class="mb-3">
                        <label for="data_naixement" class="form-label">Data de Naixement</label>
                        <input type="date" class="form-control" id="data_naixement" name="data_naixement"
                               value="<%= alumne && alumne.data_naixement ? alumne.data_naixement : '' %>">
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> Guardar
                        </button>
                        <a href="/alumnes" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Cancel·lar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../footer') %>
