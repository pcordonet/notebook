<%- include('../header') %>

<div class="row">
    <div class="col-12">
        <h1 class="mb-4">
            <i class="bi bi-people"></i> Alumnes - <%= assignatura.nom %>
        </h1>

        <div class="row">
            <div class="col-md-6">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Alumnes Inscrits</h5>
                    </div>
                    <div class="card-body">
                        <% if (alumnesInscrits.length > 0) { %>
                        <ul class="list-group">
                            <% alumnesInscrits.forEach(alumne => { %>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <a href="/alumnes/<%= alumne.id %>"><%= alumne.cognoms %>, <%= alumne.nom %></a>
                                    <br>
                                    <small class="text-muted">Inscrit: <%= alumne.data_inscripcio %></small>
                                </div>
                                <% if (alumne.actiu) { %>
                                <form action="/assignatures/<%= assignatura.id %>/alumnes/baixa/<%= alumne.id %>" method="POST" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Donar de baixa">
                                        <i class="bi bi-person-dash"></i> Baixa
                                    </button>
                                </form>
                                <% } else { %>
                                <span class="badge bg-secondary">Baixa</span>
                                <% } %>
                            </li>
                            <% }) %>
                        </ul>
                        <% } else { %>
                        <p class="text-muted mb-0">No hi ha alumnes inscrits.</p>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Inscriure Alumne</h5>
                    </div>
                    <div class="card-body">
                        <form action="/assignatures/<%= assignatura.id %>/alumnes/inscriure" method="POST">
                            <div class="mb-3">
                                <label for="alumne_id" class="form-label">Seleccionar Alumne</label>
                                <select class="form-select" id="alumne_id" name="alumne_id" required>
                                    <option value="">Seleccionar alumne...</option>
                                    <% totsAlumnes.forEach(alumne => { %>
                                    <option value="<%= alumne.id %>"><%= alumne.cognoms %>, <%= alumne.nom %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-plus-circle"></i> Inscriure
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <a href="/assignatures/<%= assignatura.id %>" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Tornar
        </a>
    </div>
</div>

<%- include('../footer') %>
