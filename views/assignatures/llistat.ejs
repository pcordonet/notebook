<%- include('../header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-journal-bookmark"></i> Assignatures</h1>
    <a href="/assignatures/crear" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Crear Assignatura
    </a>
</div>

<% if (assignatures.length > 0) { %>
<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Nom</th>
                <th>Descripció</th>
                <th>Aula</th>
                <th>Any Curs</th>
                <th>Accions</th>
            </tr>
        </thead>
        <tbody>
            <% assignatures.forEach(assignatura => { %>
            <tr>
                <td><%= assignatura.nom %></td>
                <td><%= assignatura.descripcio || '-' %></td>
                <td><%= assignatura.codi_aula %></td>
                <td><%= assignatura.any_curs %></td>
                <td>
                    <a href="/assignatures/<%= assignatura.id %>" class="btn btn-sm btn-info" title="Veure">
                        <i class="bi bi-eye"></i>
                    </a>
                    <a href="/assignatures/<%= assignatura.id %>/editar" class="btn btn-sm btn-warning" title="Editar">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <form action="/assignatures/<%= assignatura.id %>/eliminar" method="POST" class="d-inline" onsubmit="return confirm('Estàs segur?')">
                        <button type="submit" class="btn btn-sm btn-danger" title="Eliminar">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </td>
            </tr>
            <% }) %>
        </tbody>
    </table>
</div>
<% } else { %>
<div class="alert alert-info">
    <i class="bi bi-info-circle"></i> No hi ha assignatures registrades.
</div>
<% } %>

<%- include('../footer') %>
