<%- include('../header') %>

<div class="row">
    <div class="col-md-8 offset-md-2">
        <h1 class="mb-4">
            <i class="bi bi-journal-bookmark"></i>
            <%= assignatura && assignatura.id ? 'Modificar Assignatura' : 'Crear Assignatura' %>
        </h1>

        <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle"></i> <%= error %>
        </div>
        <% } %>

        <div class="card">
            <div class="card-body">
                <form action="<%= assignatura && assignatura.id ? '/assignatures/' + assignatura.id + '/editar' : '/assignatures/crear' %>" method="POST">
                    <div class="mb-3">
                        <label for="nom" class="form-label">Nom de l'Assignatura *</label>
                        <input type="text" class="form-control" id="nom" name="nom"
                               value="<%= assignatura ? assignatura.nom : '' %>" required>
                    </div>

                    <div class="mb-3">
                        <label for="descripcio" class="form-label">Descripció</label>
                        <textarea class="form-control" id="descripcio" name="descripcio" rows="3"><%= assignatura ? assignatura.descripcio : '' %></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="aula_id" class="form-label">Aula *</label>
                        <select class="form-select" id="aula_id" name="aula_id" required>
                            <option value="">Seleccionar aula...</option>
                            <% aules.forEach(aula => { %>
                            <option value="<%= aula.id %>" <%= (assignatura && assignatura.aula_id == aula.id) ? 'selected' : '' %>>
                                <%= aula.codi_aula %> - <%= aula.nom_aula || aula.any_curs %>
                            </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="actiu" name="actiu" value="1"
                                <%= (assignatura && assignatura.actiu !== 0) ? 'checked' : '' %>>
                            <label class="form-check-label" for="actiu">Assignatura activa</label>
                        </div>
                        <div class="form-text">Si està desactivada, no apareixerà al Llibre d'avaluació</div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> Guardar
                        </button>
                        <a href="/assignatures" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Cancel·lar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../footer') %>
