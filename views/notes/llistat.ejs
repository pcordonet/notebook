<%- include('../header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-pencil-square"></i> Notes</h1>
    <a href="/notes/crear" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Afegir Nota
    </a>
</div>

<% if (notes.length > 0) { %>
<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Alumne</th>
                <th>Assignatura</th>
                <th>Tipus</th>
                <th>Trimestre</th>
                <th>Nota</th>
                <th>Data</th>
                <th>Accions</th>
            </tr>
        </thead>
        <tbody>
            <% notes.forEach(nota => { %>
            <tr>
                <td><%= nota.cognoms %>, <%= nota.nom %></td>
                <td><%= nota.assignatura_nom %></td>
                <td><%= nota.tipus_nom %></td>
                <td><%= nota.trimestre ? nota.trimestre + 'r Trim' : 'Global' %></td>
                <td><span class="badge bg-primary"><%= nota.nota.toFixed(2) %></span></td>
                <td><%= nota.data %></td>
                <td>
                    <a href="/notes/<%= nota.id %>" class="btn btn-sm btn-info" title="Veure">
                        <i class="bi bi-eye"></i>
                    </a>
                    <a href="/notes/<%= nota.id %>/editar" class="btn btn-sm btn-warning" title="Editar">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <form action="/notes/<%= nota.id %>/eliminar" method="POST" class="d-inline" onsubmit="return confirm('Estàs segur?')">
                        <button type="submit" class="btn btn-sm btn-danger" title="Eliminar">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </td>
            </tr>
            <% }) %>
        </tbody>
    </table>
</div>
<% } else { %>
<div class="alert alert-info">
    <i class="bi bi-info-circle"></i> No hi ha notes registrades.
</div>
<% } %>

<%- include('../footer') %>
