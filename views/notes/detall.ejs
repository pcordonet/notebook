<%- include('../header') %>

<div class="row">
    <div class="col-md-8 offset-md-2">
        <h1 class="mb-4">
            <i class="bi bi-pencil-square"></i> Detall de la Nota
        </h1>

        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Informació de la Nota</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Alumne</dt>
                    <dd class="col-sm-8"><%= nota.cognoms %>, <%= nota.nom %></dd>

                    <dt class="col-sm-4">Assignatura</dt>
                    <dd class="col-sm-8"><%= nota.assignatura_nom %></dd>

                    <dt class="col-sm-4">Tipus de Nota</dt>
                    <dd class="col-sm-8"><%= nota.tipus_nom %></dd>

                    <dt class="col-sm-4">Trimestre</dt>
                    <dd class="col-sm-8"><%= nota.trimestre ? nota.trimestre + 'r Trimestre' : 'Global (Tot el curs)' %></dd>

                    <dt class="col-sm-4">Nota</dt>
                    <dd class="col-sm-8"><span class="badge bg-primary fs-6"><%= nota.nota.toFixed(2) %></span></dd>

                    <dt class="col-sm-4">Data</dt>
                    <dd class="col-sm-8"><%= nota.data %></dd>

                    <dt class="col-sm-4">Pes Trimestre</dt>
                    <dd class="col-sm-8"><%= nota.pes_trimestre %></dd>

                    <dt class="col-sm-4">Pes Global</dt>
                    <dd class="col-sm-8"><%= nota.pes_global %></dd>

                    <% if (nota.observacions) { %>
                    <dt class="col-sm-4">Observacions</dt>
                    <dd class="col-sm-8"><%= nota.observacions %></dd>
                    <% } %>
                </dl>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-file-earmark"></i> Documents</h5>
                <a href="/documents/pujar?nota_id=<%= nota.id %>" class="btn btn-sm btn-primary">
                    <i class="bi bi-upload"></i> Pujar Document
                </a>
            </div>
            <div class="card-body">
                <% if (documents.length > 0) { %>
                <ul class="list-group">
                    <% documents.forEach(doc => { %>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <i class="bi bi-file-earmark"></i> <%= doc.nom_fitxer %>
                            <br>
                            <small class="text-muted"><%= doc.descripcio || 'Sense descripció' %></small>
                        </div>
                        <a href="/documents/<%= doc.id %>" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-download"></i>
                        </a>
                    </li>
                    <% }) %>
                </ul>
                <% } else { %>
                <p class="text-muted mb-0">No hi ha documents associats.</p>
                <% } %>
            </div>
        </div>

        <div class="d-flex gap-2">
            <a href="/notes/<%= nota.id %>/editar" class="btn btn-warning">
                <i class="bi bi-pencil"></i> Editar
            </a>
            <a href="/notes" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Tornar
            </a>
        </div>
    </div>
</div>

<%- include('../footer') %>
