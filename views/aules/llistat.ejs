<%- include('../header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-door-open"></i> Aules</h1>
    <a href="/aules/crear" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Crear Aula
    </a>
</div>

<% if (aules.length > 0) { %>
<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Any Curs</th>
                <th>Codi Aula</th>
                <th>Nom Aula</th>
                <th>Descripció</th>
                <th>Accions</th>
            </tr>
        </thead>
        <tbody>
            <% aules.forEach(aula => { %>
            <tr>
                <td><%= aula.any_curs %></td>
                <td><strong><%= aula.codi_aula %></strong></td>
                <td><%= aula.nom_aula || '-' %></td>
                <td><%= aula.descripcio || '-' %></td>
                <td>
                    <a href="/aules/<%= aula.id %>" class="btn btn-sm btn-info" title="Veure">
                        <i class="bi bi-eye"></i>
                    </a>
                    <a href="/aules/<%= aula.id %>/editar" class="btn btn-sm btn-warning" title="Editar">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <form action="/aules/<%= aula.id %>/eliminar" method="POST" class="d-inline" onsubmit="return confirm('Estàs segur?')">
                        <button type="submit" class="btn btn-sm btn-danger" title="Eliminar">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </td>
            </tr>
            <% }) %>
        </tbody>
    </table>
</div>
<% } else { %>
<div class="alert alert-info">
    <i class="bi bi-info-circle"></i> No hi ha aules registrades.
</div>
<% } %>

<%- include('../footer') %>
