<%- include('../header') %>

<div class="row">
    <div class="col-md-8 offset-md-2">
        <h1 class="mb-4">
            <i class="bi bi-door-open"></i>
            <%= aula && aula.id ? 'Modificar Aula' : 'Crear Aula' %>
        </h1>

        <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle"></i> <%= error %>
        </div>
        <% } %>

        <div class="card">
            <div class="card-body">
                <form action="<%= aula && aula.id ? '/aules/' + aula.id + '/editar' : '/aules/crear' %>" method="POST">
                    <div class="mb-3">
                        <label for="any_curs" class="form-label">Any del Curs *</label>
                        <input type="text" class="form-control" id="any_curs" name="any_curs"
                               value="<%= aula ? aula.any_curs : '' %>" required placeholder="Ex: 2025-2026">
                    </div>

                    <div class="mb-3">
                        <label for="codi_aula" class="form-label">Codi Aula *</label>
                        <input type="text" class="form-control" id="codi_aula" name="codi_aula"
                               value="<%= aula ? aula.codi_aula : '' %>" required placeholder="Ex: A-101">
                    </div>

                    <div class="mb-3">
                        <label for="nom_aula" class="form-label">Nom Aula</label>
                        <input type="text" class="form-control" id="nom_aula" name="nom_aula"
                               value="<%= aula ? aula.nom_aula : '' %>" placeholder="Ex: Aula d'Informàtica">
                    </div>

                    <div class="mb-3">
                        <label for="descripcio" class="form-label">Descripció</label>
                        <textarea class="form-control" id="descripcio" name="descripcio" rows="3"><%= aula ? aula.descripcio : '' %></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> Guardar
                        </button>
                        <a href="/aules" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Cancel·lar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../footer') %>
